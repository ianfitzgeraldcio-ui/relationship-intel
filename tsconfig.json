{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "packages"
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/mcp-server/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
